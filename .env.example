# ============================================================
# Kali-OpenClaw — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --------------- AI Providers (at least one required) ---------------

# Anthropic (Claude) — highest priority
ANTHROPIC_API_KEY=

# OpenAI (GPT)
# OPENAI_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# Google Gemini
# GEMINI_API_KEY=

# xAI (Grok)
# XAI_API_KEY=

# Groq
# GROQ_API_KEY=

# Mistral
# MISTRAL_API_KEY=

# Ollama local (e.g. http://host.docker.internal:11434)
# OLLAMA_BASE_URL=

# --------------- Auth & Gateway ---------------

# Web UI password — if unset, UI is open (no auth)
AUTH_PASSWORD=

# Web UI username (default: admin)
# AUTH_USERNAME=admin

# Gateway API token — auto-generated if unset
# OPENCLAW_GATEWAY_TOKEN=

# External port (default: 8080)
# PORT=8080

# --------------- Messaging Channels ---------------

# Telegram bot token from @BotFather
# TELEGRAM_BOT_TOKEN=

# Telegram DM policy: pairing | allowlist | open
# TELEGRAM_DM_POLICY=pairing

# Discord bot token
# DISCORD_BOT_TOKEN=

# --------------- Extras ---------------

# Space-separated apt packages to install at startup
# e.g. nmap sqlmap nikto metasploit-framework
# OPENCLAW_DOCKER_APT_PACKAGES=

# Override primary model (e.g. anthropic/claude-sonnet-4-5-20250929)
# OPENCLAW_PRIMARY_MODEL=
