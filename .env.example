# ============================================================
# OpenClaw Quant + Hacker Toolkit — Environment Variables
# Copy this file to .env and fill in your values.
# Or set these in the Zeabur Dashboard under Environment Variables.
# ============================================================

# ─── AI Providers (at least one required) ───────────────────

# Anthropic (Claude) — highest priority
ANTHROPIC_API_KEY=

# OpenAI (GPT)
# OPENAI_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# Google Gemini
# GEMINI_API_KEY=

# xAI (Grok)
# XAI_API_KEY=

# Groq
# GROQ_API_KEY=

# Mistral
# MISTRAL_API_KEY=

# Ollama local (e.g. http://host.docker.internal:11434)
# OLLAMA_BASE_URL=

# ─── Auth & Gateway ─────────────────────────────────────────

# Web UI password — if unset, UI is open (no auth)
AUTH_PASSWORD=

# Web UI username (default: admin)
# AUTH_USERNAME=admin

# Gateway API token — auto-generated if unset
# OPENCLAW_GATEWAY_TOKEN=

# External port (default: 8080)
# PORT=8080

# Override primary model (e.g. anthropic/claude-sonnet-4-5-20250929)
# OPENCLAW_PRIMARY_MODEL=

# ─── Messaging Channels ─────────────────────────────────────

# Telegram bot token from @BotFather
# TELEGRAM_BOT_TOKEN=

# Telegram DM policy: pairing | allowlist | open
# TELEGRAM_DM_POLICY=pairing

# Discord bot token
# DISCORD_BOT_TOKEN=

# ─── Trading & Market Data ──────────────────────────────────

# Alpaca (paper or live trading)
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Binance
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=

# OKX
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=

# Polygon.io
# POLYGON_API_KEY=

# Interactive Brokers (local gateway)
# IB_HOST=127.0.0.1
# IB_PORT=7497

# ─── OSINT & Recon ──────────────────────────────────────────

# Shodan
# SHODAN_API_KEY=

# Censys
# CENSYS_API_ID=
# CENSYS_API_SECRET=

# VirusTotal
# VT_API_KEY=

# ─── Social Media ───────────────────────────────────────────

# Reddit
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Twitter / X
# TWITTER_BEARER_TOKEN=

# ─── Blockchain ─────────────────────────────────────────────

# Infura (Ethereum RPC)
# INFURA_PROJECT_ID=

# Alchemy
# ALCHEMY_API_KEY=

# Etherscan
# ETHERSCAN_API_KEY=

# Dune Analytics
# DUNE_API_KEY=

# ─── Cloud ──────────────────────────────────────────────────

# AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# ─── Notifications ──────────────────────────────────────────

# Telegram (for trading alerts / notifications)
# TELEGRAM_CHAT_ID=

# Discord
# DISCORD_WEBHOOK_URL=

# Slack
# SLACK_WEBHOOK_URL=

# ─── Extras ─────────────────────────────────────────────────

# Space-separated apt packages to install at startup
# e.g. nmap sqlmap nikto metasploit-framework
# OPENCLAW_DOCKER_APT_PACKAGES=
