{
  "name": "AdventureWorks",
  "compatibilityLevel": 1567,
  "model": {
    "name": "Model",
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataSources": [
      {
        "name": "SqlServer localhost AdventureWorksDW",
        "connectionString": "Data Source=localhost;Initial Catalog=AdventureWorksDW",
        "impersonationMode": "impersonateServiceAccount"
      }
    ],
    "tables": [
      {
        "name": "Sales",
        "description": "Fact table containing all sales transactions",
        "columns": [
          {
            "name": "SalesOrderID",
            "type": "data",
            "dataType": "int64",
            "isKey": true,
            "sourceColumn": "SalesOrderID",
            "summarizeBy": "none"
          },
          {
            "name": "ProductKey",
            "type": "data",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "ProductKey",
            "summarizeBy": "none"
          },
          {
            "name": "CustomerKey",
            "type": "data",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "CustomerKey",
            "summarizeBy": "none"
          },
          {
            "name": "OrderDateKey",
            "type": "data",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "OrderDateKey",
            "summarizeBy": "none"
          },
          {
            "name": "ShipDateKey",
            "type": "data",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "ShipDateKey",
            "summarizeBy": "none"
          },
          {
            "name": "Quantity",
            "type": "data",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "summarizeBy": "sum"
          },
          {
            "name": "UnitPrice",
            "type": "data",
            "dataType": "decimal",
            "sourceColumn": "UnitPrice",
            "formatString": "$#,0.00",
            "summarizeBy": "none"
          },
          {
            "name": "Discount",
            "type": "data",
            "dataType": "double",
            "sourceColumn": "Discount",
            "formatString": "0.00%",
            "summarizeBy": "none"
          },
          {
            "name": "SalesAmount",
            "type": "data",
            "dataType": "decimal",
            "sourceColumn": "SalesAmount",
            "formatString": "$#,0.00",
            "summarizeBy": "sum"
          },
          {
            "name": "OrderStatus",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "OrderStatus",
            "summarizeBy": "default"
          },
          {
            "name": "RowMargin",
            "type": "calculated",
            "dataType": "decimal",
            "expression": "Sales[SalesAmount] - Sales[Quantity] * Sales[UnitPrice] * (1 - Sales[Discount])",
            "formatString": "$#,0.00",
            "summarizeBy": "sum"
          },
          {
            "name": "IsProfitable",
            "type": "calculated",
            "dataType": "boolean",
            "expression": "Sales[RowMargin] > 0",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM(Sales[SalesAmount])",
            "formatString": "$#,0.00",
            "description": "Sum of all sales amounts",
            "displayFolder": "Revenue"
          },
          {
            "name": "Total Quantity",
            "expression": "SUM(Sales[Quantity])",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Total Sales], DISTINCTCOUNT(Sales[SalesOrderID]), 0)",
            "formatString": "$#,0.00",
            "displayFolder": "Revenue"
          },
          {
            "name": "Sales YTD",
            "expression": "TOTALYTD([Total Sales], 'Calendar'[Date])",
            "formatString": "$#,0.00",
            "displayFolder": "Time Intelligence"
          },
          {
            "name": "Sales PY",
            "expression": "CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "$#,0.00",
            "displayFolder": "Time Intelligence"
          },
          {
            "name": "Sales YoY %",
            "expression": "VAR CurrentSales = [Total Sales]\nVAR PriorSales = [Sales PY]\nRETURN\n    DIVIDE(CurrentSales - PriorSales, PriorSales, BLANK())",
            "formatString": "0.0%",
            "displayFolder": "Time Intelligence"
          },
          {
            "name": "Margin",
            "expression": "SUMX(Sales, Sales[SalesAmount] - Sales[Quantity] * Sales[UnitPrice] * (1 - Sales[Discount]))",
            "formatString": "$#,0.00",
            "displayFolder": "Revenue"
          },
          {
            "name": "Margin %",
            "expression": "DIVIDE([Margin], [Total Sales], 0)",
            "formatString": "0.0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "Weighted Avg Price",
            "expression": "SUMX(Sales, Sales[Quantity] * Sales[UnitPrice]) / SUM(Sales[Quantity])",
            "displayFolder": "Pricing"
          },
          {
            "name": "Complex Metric",
            "expression": "CALCULATE(SUMX(ADDCOLUMNS(SUMMARIZE(Sales, Product[Category], Product[Subcategory]), \"SubTotal\", CALCULATE(SUMX(Sales, Sales[Quantity] * Sales[UnitPrice]))), [SubTotal]), FILTER(ALL(Product[Category]), COUNTROWS(FILTER(Sales, RELATED(Product[Category]) = EARLIER(Product[Category]))) > 100))",
            "displayFolder": "Advanced"
          },
          {
            "name": "Running Total",
            "expression": "CALCULATE([Total Sales], FILTER(ALL('Calendar'[Date]), 'Calendar'[Date] <= MAX('Calendar'[Date])))"
          },
          {
            "name": "Customer Count",
            "expression": "DISTINCTCOUNT(Sales[CustomerKey])",
            "formatString": "#,0",
            "displayFolder": "Customers"
          }
        ],
        "partitions": [
          {
            "name": "Sales-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = Sql.Database(\"localhost\", \"AdventureWorksDW\"), Sales = Source{[Schema=\"dbo\",Item=\"FactInternetSales\"]}[Data] in Sales"
            }
          }
        ]
      },
      {
        "name": "Product",
        "description": "Product dimension table",
        "columns": [
          {
            "name": "ProductKey",
            "type": "data",
            "dataType": "int64",
            "isKey": true,
            "sourceColumn": "ProductKey",
            "summarizeBy": "none"
          },
          {
            "name": "ProductName",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "EnglishProductName",
            "summarizeBy": "none"
          },
          {
            "name": "Category",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "Subcategory",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "Subcategory",
            "summarizeBy": "none"
          },
          {
            "name": "Color",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "Color",
            "summarizeBy": "default"
          },
          {
            "name": "ListPrice",
            "type": "data",
            "dataType": "decimal",
            "sourceColumn": "ListPrice",
            "formatString": "$#,0.00",
            "summarizeBy": "none"
          },
          {
            "name": "StandardCost",
            "type": "data",
            "dataType": "decimal",
            "sourceColumn": "StandardCost",
            "formatString": "$#,0.00",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Product Count",
            "expression": "COUNTROWS(Product)",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Product-Partition",
            "mode": "import"
          }
        ],
        "hierarchies": [
          {
            "name": "Product Hierarchy",
            "levels": [
              { "ordinal": 0, "name": "Category", "column": "Category" },
              { "ordinal": 1, "name": "Subcategory", "column": "Subcategory" },
              { "ordinal": 2, "name": "Product", "column": "ProductName" }
            ]
          }
        ]
      },
      {
        "name": "Customer",
        "columns": [
          {
            "name": "CustomerKey",
            "type": "data",
            "dataType": "int64",
            "isKey": true,
            "sourceColumn": "CustomerKey",
            "summarizeBy": "none"
          },
          {
            "name": "FullName",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "FullName",
            "summarizeBy": "none"
          },
          {
            "name": "Email",
            "type": "data",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "EmailAddress",
            "summarizeBy": "none"
          },
          {
            "name": "City",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "City",
            "summarizeBy": "none"
          },
          {
            "name": "Country",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "CountryRegionName",
            "summarizeBy": "none"
          },
          {
            "name": "Gender",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "Gender",
            "summarizeBy": "default"
          },
          {
            "name": "AgeGroup",
            "type": "calculated",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), Customer[BirthYear] >= 1997, \"Gen Z\", Customer[BirthYear] >= 1981, \"Millennial\", Customer[BirthYear] >= 1965, \"Gen X\", \"Boomer\")",
            "summarizeBy": "none"
          },
          {
            "name": "BirthYear",
            "type": "data",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "BirthYear",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Customer Count",
            "expression": "DISTINCTCOUNT(Customer[CustomerKey])",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Customer-Partition",
            "mode": "import"
          }
        ]
      },
      {
        "name": "Calendar",
        "description": "Date dimension table",
        "columns": [
          {
            "name": "DateKey",
            "type": "data",
            "dataType": "int64",
            "isKey": true,
            "isHidden": true,
            "sourceColumn": "DateKey",
            "summarizeBy": "none"
          },
          {
            "name": "Date",
            "type": "data",
            "dataType": "dateTime",
            "sourceColumn": "FullDateAlternateKey",
            "formatString": "yyyy-MM-dd",
            "summarizeBy": "none"
          },
          {
            "name": "Year",
            "type": "data",
            "dataType": "int64",
            "sourceColumn": "CalendarYear",
            "summarizeBy": "none"
          },
          {
            "name": "Quarter",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "CalendarQuarter",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "EnglishMonthName",
            "summarizeBy": "none",
            "sortByColumn": "MonthNumber"
          },
          {
            "name": "MonthNumber",
            "type": "data",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "MonthNumberOfYear",
            "summarizeBy": "none"
          },
          {
            "name": "DayOfWeek",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "EnglishDayNameOfWeek",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Calendar-Partition",
            "mode": "import"
          }
        ],
        "hierarchies": [
          {
            "name": "Date Hierarchy",
            "levels": [
              { "ordinal": 0, "name": "Year", "column": "Year" },
              { "ordinal": 1, "name": "Quarter", "column": "Quarter" },
              { "ordinal": 2, "name": "Month", "column": "Month" }
            ]
          }
        ]
      },
      {
        "name": "Geography",
        "columns": [
          {
            "name": "GeographyKey",
            "type": "data",
            "dataType": "int64",
            "isKey": true,
            "sourceColumn": "GeographyKey",
            "summarizeBy": "none"
          },
          {
            "name": "City",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "City",
            "summarizeBy": "none"
          },
          {
            "name": "StateProvince",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "StateProvinceName",
            "summarizeBy": "none"
          },
          {
            "name": "Country",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "CountryRegionName",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Geography-Partition",
            "mode": "import"
          }
        ]
      },
      {
        "name": "StagingTable",
        "isHidden": false,
        "columns": [
          {
            "name": "ID",
            "type": "data",
            "dataType": "int64",
            "sourceColumn": "ID",
            "summarizeBy": "none"
          },
          {
            "name": "TempValue",
            "type": "data",
            "dataType": "string",
            "sourceColumn": "TempValue",
            "summarizeBy": "default"
          }
        ],
        "partitions": [
          {
            "name": "StagingTable-Partition",
            "mode": "import"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "FK_Sales_Product",
        "fromTable": "Sales",
        "fromColumn": "ProductKey",
        "fromCardinality": "many",
        "toTable": "Product",
        "toColumn": "ProductKey",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "FK_Sales_Customer",
        "fromTable": "Sales",
        "fromColumn": "CustomerKey",
        "fromCardinality": "many",
        "toTable": "Customer",
        "toColumn": "CustomerKey",
        "toCardinality": "one",
        "crossFilteringBehavior": "bothDirections",
        "isActive": true
      },
      {
        "name": "FK_Sales_OrderDate",
        "fromTable": "Sales",
        "fromColumn": "OrderDateKey",
        "fromCardinality": "many",
        "toTable": "Calendar",
        "toColumn": "DateKey",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection",
        "isActive": true
      },
      {
        "name": "FK_Sales_ShipDate",
        "fromTable": "Sales",
        "fromColumn": "ShipDateKey",
        "fromCardinality": "many",
        "toTable": "Calendar",
        "toColumn": "DateKey",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection",
        "isActive": false
      }
    ],
    "roles": [
      {
        "name": "US Only",
        "modelPermission": "read",
        "members": [],
        "tablePermissions": [
          {
            "name": "Customer",
            "filterExpression": "Customer[Country] = \"United States\""
          }
        ]
      }
    ]
  }
}
